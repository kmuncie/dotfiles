.DS_Store
*.swp

# Vim plugin data (managed by vim-plug, not checked in)
common/.vim/plugged
common/.vim/.netrwhist

# Tmux session data and TPM-managed plugins (bootstrapped by bootstrap.sh)
personal/.tmux/resurrect
personal/.tmux/plugins/

# Zsh compiled/cached files
personal/.zsh_plugins.zsh
personal/.zcompdump*

# Backup files
*.bak

# Per-machine tool state. None of this is secret, but it is specific to one
# machine and this repo is public, so there is nothing to gain by publishing it.
# 1Password writes a device-registration ID here; gh writes the logged-in
# account. Deliberate exception: personal/.config/gh/config.yml IS tracked,
# because it holds real preferences (the `co` alias) rather than machine state.
personal/.config/op/
personal/.config/gh/hosts.yml

# Generated by setup-ai-tools.sh from the agentic-ai-workflows repo, not authored
# here. Regenerate rather than check in.
personal/.config/devin/

# Pi coding agent. Only models.json is tracked — it holds the local llama.cpp
# provider definition, which is real config. Everything else in that directory is
# either machine state or secret: auth.json holds provider credentials, and this
# repo is public. Deny the directory, then re-allow the one file.
personal/.pi/*
!personal/.pi/agent/
personal/.pi/agent/*
!personal/.pi/agent/models.json
